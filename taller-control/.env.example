# =====================================================================
# Taller Control · variables de entorno
#
# Copia este archivo como .env.local (en tu PC) o pega estas variables en
# EasyPanel (pestaña Environment). NUNCA subas .env.local al repositorio.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Dónde está la base de datos. En Supabase: Project Settings → API.
# Para desarrollo local, `npm run db:iniciar` imprime estos valores.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave pública (anon). La app la usa con la sesión de cada persona: la
# base de datos aplica los permisos por rol (RLS).
SUPABASE_ANON_KEY=

# Llave de servicio (service_role). SECRETA: se salta los permisos.
# Solo la usa el servidor para crear accesos y cambiar contraseñas,
# siempre después de verificar que quien lo pide tiene permiso.
SUPABASE_SERVICE_ROLE_KEY=

# --- Datos de ejemplo (solo pruebas) ----------------------------------
# Contraseña de las personas ficticias de `npm run datos:ejemplo` cuando
# se usa un proyecto de PRUEBAS en la nube. En local es "taller-ejemplo".
# CLAVE_EJEMPLO=

# Solo para `npm run respaldo -- --nube`: cadena de conexión a la base
# (Supabase → Project Settings → Database → Connection string → URI).
# Contiene la contraseña de la base: nunca la compartas ni la subas.
SUPABASE_DB_URL=
